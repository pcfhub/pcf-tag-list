{
    "schemaVersion": 1,

    "slug": "pcf-tag-list",
    "name": "Tag List",
    "tagline": "A multi-select lookup for model-driven forms: related records as chips, with a type-ahead to attach more.",
    "category": "data",
    "hosts": ["model-driven"],
    "tags": ["react", "chips", "many-to-many", "multi-select", "lookup"],

    "control": {
        "namespace": "PCFHub",
        "constructor": "TagList",
        "type": "dataset",
        "framework": "react_virtual",
        "manifestPath": "TagList/ControlManifest.Input.xml"
    },

    "links": {
        "homepage": "https://github.com/pcfhub/pcf-tag-list",
        "support": "https://github.com/pcfhub/pcf-tag-list/issues",
        "license": "MIT"
    },

    "docs": {
        "path": "docs"
    },

    "media": {
        "logo": "media/logo.png",
        "screenshots": ["media/screenshot.png", "media/search.png", "media/narrow.png"]
    },

    "demo": {
        "fidelity": "limited",
        "limitations": [
            "No record to attach tags to: the demo shows the chips and the notice the control shows off a saved record, with no search box or remove buttons.",
            "Search, Browse, linking and unlinking all need Dataverse and a model-driven form."
        ],
        "bundle": "out/controls/TagList/bundle.js",
        "styles": ["out/controls/TagList/css/TagList.css"],
        "datasetFixture": "demo/tags.json",
        "presets": [
            {
                "slug": "default",
                "name": "Default",
                "description": "A typical set of tags on a record.",
                "props": {},
                "isDefault": true
            }
        ]
    }
}
