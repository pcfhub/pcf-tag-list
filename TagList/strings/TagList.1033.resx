<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — TagList.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="TagList_Name" xml:space="preserve">
    <value>Tag List</value>
  </data>
  <data name="TagList_Desc" xml:space="preserve">
    <value>A many-to-many tag picker rendered as removable chips, bound to a dataset.</value>
  </data>

  <data name="Tags_DataSet_Name" xml:space="preserve">
    <value>Tags</value>
  </data>

  <data name="LabelField_Name" xml:space="preserve">
    <value>Label field</value>
  </data>
  <data name="ColorField_Name" xml:space="preserve">
    <value>Colour field</value>
  </data>

  <data name="AllowCreate_Name" xml:space="preserve">
    <value>Allow adding tags</value>
  </data>
  <data name="AllowCreate_Desc" xml:space="preserve">
    <value>Shows the box for adding tags. Turn off for a read-only chip list.</value>
  </data>

  <data name="MaxVisible_Name" xml:space="preserve">
    <value>Maximum visible chips</value>
  </data>
  <data name="MaxVisible_Desc" xml:space="preserve">
    <value>Chips beyond this count collapse into a "+N more" affordance.</value>
  </data>

  <data name="PrimaryNameField_Name" xml:space="preserve">
    <value>Primary name field</value>
  </data>
  <data name="PrimaryNameField_Desc" xml:space="preserve">
    <value>Used only when the tag table's metadata cannot be read: its primary name column, searched and written to when a tag is created.</value>
  </data>

  <data name="ParentLookupField_Name" xml:space="preserve">
    <value>Parent lookup field</value>
  </data>
  <data name="ParentLookupField_Desc" xml:space="preserve">
    <value>No longer used: the lookup is found from metadata. Kept so existing forms import cleanly.</value>
  </data>

  <data name="SelectedTagId_Name" xml:space="preserve">
    <value>Selected tag id</value>
  </data>
  <data name="SelectedTagId_Desc" xml:space="preserve">
    <value>The id of the tag whose chip was last opened, for a form to react to.</value>
  </data>

  <!-- Runtime UI strings — read via context.resources.getString() in
       TagListControl.tsx, not the maker's properties pane. "{0}" is a
       placeholder the component substitutes itself (getString does no
       formatting of its own). -->
  <data name="TagList_Loading" xml:space="preserve">
    <value>Loading…</value>
  </data>
  <data name="TagList_Empty" xml:space="preserve">
    <value>No tags yet</value>
  </data>
  <data name="TagList_MoreButton" xml:space="preserve">
    <value>+{0} more</value>
  </data>
  <data name="TagList_RemoveLabel" xml:space="preserve">
    <value>Remove {0}</value>
  </data>
  <data name="TagList_AddPlaceholder" xml:space="preserve">
    <value>Add a tag…</value>
  </data>
  <data name="AllowNewTags_Name" xml:space="preserve">
    <value>Allow new tags</value>
  </data>
  <data name="AllowNewTags_Desc" xml:space="preserve">
    <value>Offers to create a tag that does not exist yet. Turn off to attach existing tags only.</value>
  </data>
  <data name="RelationshipName_Name" xml:space="preserve">
    <value>Relationship name</value>
  </data>
  <data name="RelationshipName_Desc" xml:space="preserve">
    <value>Only needed when more than one relationship joins the two tables: the relationship this subgrid shows (its schema name, or a lookup column). The control lists the candidates when it is needed.</value>
  </data>
  <data name="TagList_MoreUnknown" xml:space="preserve">
    <value>More…</value>
  </data>
  <data name="TagList_ShowFewer" xml:space="preserve">
    <value>Show fewer</value>
  </data>
  <data name="TagList_LoadMore" xml:space="preserve">
    <value>Load more</value>
  </data>
  <data name="TagList_Browse" xml:space="preserve">
    <value>Browse</value>
  </data>
  <data name="TagList_BrowseLabel" xml:space="preserve">
    <value>Browse all tags</value>
  </data>
  <data name="TagList_CreateOption" xml:space="preserve">
    <value>Create “{0}”</value>
  </data>
  <data name="TagList_Searching" xml:space="preserve">
    <value>Searching…</value>
  </data>
  <data name="TagList_NoMatches" xml:space="preserve">
    <value>No matching tags</value>
  </data>
  <data name="TagList_Dismiss" xml:space="preserve">
    <value>Dismiss</value>
  </data>
  <data name="TagList_ErrorAdd" xml:space="preserve">
    <value>{0} could not be added. {1}</value>
  </data>
  <data name="TagList_ErrorRemove" xml:space="preserve">
    <value>{0} could not be removed. {1}</value>
  </data>
  <data name="TagList_ErrorSearch" xml:space="preserve">
    <value>Tags could not be searched. {0}</value>
  </data>
  <data name="TagList_NoticeAmbiguous" xml:space="preserve">
    <value>More than one relationship joins these tables. Set Relationship name to one of: {0}.</value>
  </data>
  <data name="TagList_NoticeUnmatched" xml:space="preserve">
    <value>Relationship name does not match a relationship between these tables.</value>
  </data>
  <data name="TagList_NoticeNoRelationship" xml:space="preserve">
    <value>No relationship joins these tables, so tags can be shown but not changed.</value>
  </data>
  <data name="TagList_NoticeNoParent" xml:space="preserve">
    <value>Save the record to add tags.</value>
  </data>
  <data name="TagList_NoticeNoMetadata" xml:space="preserve">
    <value>The tables' relationships could not be read, so tags can be shown but not changed.</value>
  </data>
  <data name="TagList_NoticeSelf" xml:space="preserve">
    <value>A table related to itself is not supported, so tags can be shown but not changed.</value>
  </data>
  <data name="TagList_ConfirmTitle" xml:space="preserve">
    <value>Remove tag</value>
  </data>
  <data name="TagList_ConfirmText" xml:space="preserve">
    <value>Remove {0} from this record? The link row is deleted; the tag itself is kept.</value>
  </data>
  <data name="SampleData_Name" xml:space="preserve">
    <value>Sample data (demo only)</value>
  </data>
  <data name="SampleData_Desc" xml:space="preserve">
    <value>A JSON document of tags the control shows instead of the record's. Leave blank on a real form.</value>
  </data>
  <data name="TagList_NoticeSample" xml:space="preserve">
    <value>The sample data could not be read, so no tags are shown.</value>
  </data>
</root>
