<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="PCFHub" constructor="TagList" version="0.3.2" display-name-key="TagList_Name" description-key="TagList_Desc" control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>

    <!-- Dataset binding: the set of tags currently associated to the record.
         property-set entries let the author's view choose which columns play
         which role, instead of the control assuming fixed column names. -->
    <data-set name="tags" display-name-key="Tags_DataSet_Name">
      <property-set name="labelField" display-name-key="LabelField_Name" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="colorField" display-name-key="ColorField_Name" of-type="SingleLine.Text" usage="bound" required="false" />
    </data-set>

    <!-- allowCreate keeps its 0.2.x meaning — false hides the add box, which is
         how a read-only chip list was documented — so an existing form set to
         false gains no search box on upgrade. allowNewTags is new and splits
         the add box: off, it attaches existing tags only. -->
    <property name="allowCreate" display-name-key="AllowCreate_Name" description-key="AllowCreate_Desc" of-type="TwoOptions" usage="input" required="false" default-value="true" />
    <property name="allowNewTags" display-name-key="AllowNewTags_Name" description-key="AllowNewTags_Desc" of-type="TwoOptions" usage="input" required="false" default-value="true" />
    <property name="maxVisible" display-name-key="MaxVisible_Name" description-key="MaxVisible_Desc" of-type="Whole.None" usage="input" required="false" default-value="12" />
    <property name="primaryNameField" display-name-key="PrimaryNameField_Name" description-key="PrimaryNameField_Desc" of-type="SingleLine.Text" usage="input" required="false" default-value="name" />

    <!-- Which relationship the subgrid shows. The subgrid does not report it
         (getFilter() is null on a relationship subgrid, measured 2026-09-23),
         so binding.ts reads it from metadata; this input is needed only when
         more than one relationship joins the two tables, and the control
         says so and lists them when it is. Takes an N:N SchemaName, a 1:N
         SchemaName, or a lookup column's logical name. -->
    <property name="relationshipName" display-name-key="RelationshipName_Name" description-key="RelationshipName_Desc" of-type="SingleLine.Text" usage="input" required="false" />

    <!-- Kept so existing forms import cleanly, and no longer read: 0.3.0
         finds the lookup from metadata. It is deliberately not treated as a
         relationship name — a table can have a lookup to the parent *and* a
         many-to-many with it (the probe's did), and a value set for 0.2.x's
         create path would then pick the lookup under an N:N subgrid. -->
    <property name="parentLookupField" display-name-key="ParentLookupField_Name" description-key="ParentLookupField_Desc" of-type="SingleLine.Text" usage="input" required="false" />

    <property name="selectedTagId" display-name-key="SelectedTagId_Name" description-key="SelectedTagId_Desc" of-type="SingleLine.Text" usage="output" />

    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/TagList.css" order="1" />
      <resx path="strings/TagList.1033.resx" version="1.0.0" />
      <resx path="strings/TagList.3082.resx" version="1.0.0" />
      <resx path="strings/TagList.1036.resx" version="1.0.0" />
      <resx path="strings/TagList.1031.resx" version="1.0.0" />
      <resx path="strings/TagList.1041.resx" version="1.0.0" />
      <platform-library name="React" version="16.8.6" />
    </resources>

    <!-- Unchanged from 0.2.x, so an upgrade adds nothing to the import
         prompt. WebAPI: search, create, and a one-to-many bind. Utility:
         getEntityMetadata for entity set names, and lookupObjects for Browse.
         The many-to-many link itself is a same-origin $ref request, which
         needs no feature at all — context.webAPI has no relationship verbs. -->
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
